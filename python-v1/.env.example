# --- Model saglayicisi -------------------------------------------------------
# Hepsi OpenAI-uyumlu endpoint kullanir, sadece asagidaki 3 degeri degistir.
#
# 1) Google Gemini  (onerilen - ucretsiz, kredi karti istemiyor)
#    Anahtar: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash-lite
LLM_API_KEY=buraya-anahtarini-yaz

# 2) Groq  (cok hizli, 1000 istek/gun ucretsiz)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# 3) OpenRouter  (tek anahtarla onlarca model, :free modeller var)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-r1:free
# LLM_API_KEY=sk-or-...

# 4) Ollama  (tamamen lokal, sinirsiz, internet gerekmez)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# --- Uygulama ----------------------------------------------------------------
# Sorgu sonuclari SQLite'a yazilir; ayni kelime tekrar sorulunca API'ye
# gidilmez. Ucretsiz kotayi cok uzatir. Gun cinsinden gecerlilik suresi:
CACHE_TTL_DAYS=90
DB_PATH=data/sozluk.db
HOST=127.0.0.1
PORT=8000
